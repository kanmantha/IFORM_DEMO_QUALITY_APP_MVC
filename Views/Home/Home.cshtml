@{
    ViewData["Title"] = "Home";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Welcome to I-FORM Quality Portal</h4>
        <span class="text-muted">Select a module to get started.</span>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-controller="Home" asp-action="UnderConstruction" asp-route-module="Work Permit"
           class="text-decoration-none module-card-link">
            <div class="module-card">
                <div class="module-icon blue"><i class="bi bi-clipboard-check"></i></div>
                <h5 class="fw-bold mb-1">Work Permit</h5>
                <p class="text-muted mb-0">Create and manage work permits for site operations.</p>
                <span class="module-action"><i class="bi bi-arrow-right-circle"></i> Open</span>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-controller="Home" asp-action="UnderConstruction" asp-route-module="Quality"
           class="text-decoration-none module-card-link">
            <div class="module-card">
                <div class="module-icon green"><i class="bi bi-award"></i></div>
                <h5 class="fw-bold mb-1">Quality</h5>
                <p class="text-muted mb-0">Track quality checks, inspections and compliance.</p>
                <span class="module-action"><i class="bi bi-arrow-right-circle"></i> Open</span>
            </div>
        </a>
    </div>
    <div class="col-12 col-md-6 col-xl-4">
        <a asp-controller="Home" asp-action="UnderConstruction" asp-route-module="Safety"
           class="text-decoration-none module-card-link">
            <div class="module-card">
                <div class="module-icon amber"><i class="bi bi-shield-check"></i></div>
                <h5 class="fw-bold mb-1">Safety</h5>
                <p class="text-muted mb-0">Manage safety reports, hazards and observations.</p>
                <span class="module-action"><i class="bi bi-arrow-right-circle"></i> Open</span>
            </div>
        </a>
    </div>
</div>