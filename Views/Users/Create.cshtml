@model RegisterViewModel
@{
    ViewData["Title"] = "Add User";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1">Add New User</h4>
        <span class="text-muted">Create a new user account with a role assignment</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Users
    </a>
</div>

<div class="card" style="max-width: 680px;">
    <div class="card-header"><i class="bi bi-person-plus me-2"></i>New User</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" autofocus placeholder="e.g. Venkata Sai" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" placeholder="e.g. sai@iform.in" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="EmployeeCode" class="form-label">Employee Code <span class="text-danger">*</span></label>
                    <input asp-for="EmployeeCode" class="form-control" placeholder="e.g. ENG005" />
                    <span asp-validation-for="EmployeeCode" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Department" class="form-label">Department <span class="text-danger">*</span></label>
                    <input asp-for="Department" class="form-control" placeholder="e.g. Site" />
                    <span asp-validation-for="Department" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" class="form-select">
                        @foreach (var role in (List<string>)ViewBag.Roles)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Password <span class="text-danger">*</span></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                    <div class="form-text">Min 6 chars, must include uppercase, lowercase, digit, and special character.</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-person-check me-1"></i>Create User
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
